# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Required for Groq free-tier fallback (Tier 2)
GROQ_API_KEY=

# Required for OpenRouter free-tier catch-all (Tier 3) and the Router's Jev classifier
OPENROUTER_API_KEY=

# Optional — only needed if Tier 1 routes to a remote Anthropic endpoint
ANTHROPIC_API_KEY=

# Password for the dashboard, chat and API. Optional on your own PC; required
# by the Docker setup (docker-compose.yml). Browsers ask for it (any user name);
# Claude Code sends it as ANTHROPIC_AUTH_TOKEN.
# HARNESS_PASSWORD=

# Optional — LiteLLM master key (required by the Docker setup). Set it to lock the Gateway and log in to the
# LiteLLM admin UI (http://localhost:4000/ui, user "admin", this key as password).
# LiteLLM and the harness both read it from here. Any string starting with sk-.
# LITELLM_MASTER_KEY=sk-...

# Optional — Postgres for LiteLLM's admin UI pages (keys, users, spend). See README.
# DATABASE_URL=postgresql://postgres:litellm@localhost:5432/postgres

# Optional: read-aloud in the chat page. With OPENROUTER_API_KEY set it uses
# OpenRouter's speech models (pick model and voice in the page). These override:
# TTS_URL=                 # another OpenAI-style server, e.g. Kokoro: http://localhost:8880/v1
# TTS_MODEL=               # default model (OpenRouter: fish-audio/s2.1-pro-free:free)
# TTS_VOICE=               # default voice
# TTS_API_KEY=             # key for TTS_URL (not needed for OpenRouter)
# TTS_VOICES=              # comma-separated voices when the server doesn't list them
# TTS_INSTRUCTIONS=        # tone/pacing for models that take it
