# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Required for Groq free-tier fallback (Tier 2)
GROQ_API_KEY=

# Required for OpenRouter free-tier catch-all (Tier 3) and the Router's Jev classifier
OPENROUTER_API_KEY=

# Optional — only needed if Tier 1 routes to a remote Anthropic endpoint
ANTHROPIC_API_KEY=

# Password for the dashboard, chat and API. Optional on your own PC; required
# by the Docker setup (docker-compose.yml). Browsers ask for it (any user name);
# Claude Code sends it as ANTHROPIC_AUTH_TOKEN.
# HARNESS_PASSWORD=

# `npm run claude` reads these: HARNESS_URL is the harness to talk to (default
# http://localhost:3000, set it for another machine or a tunnel), and
# HARNESS_API_KEY is an API key from the Users page when HARNESS_REQUIRE_LOGIN=1.
# HARNESS_URL=http://localhost:3000
# HARNESS_API_KEY=

# Or named logins instead of one shared password: make a hash with `npm run hash`,
# then list admins as name:hash pairs. Admins add other users and API keys inside
# the app (saved in users.json). Refuses to start if no valid admin is listed.
# HARNESS_REQUIRE_LOGIN=1
# HARNESS_ADMINS=alice:scrypt.16384.xxxx.yyyy,bob:scrypt.16384.xxxx.yyyy

# Optional: also start Ollama with `npm run all` (off by default; or run `npm run all:ollama`)
# START_OLLAMA=1

# Optional — LiteLLM master key (required by the Docker setup). Set it to lock the Gateway and log in to the
# LiteLLM admin UI (http://localhost:4000/ui, user "admin", this key as password).
# LiteLLM and the harness both read it from here. Any string starting with sk-.
# LITELLM_MASTER_KEY=sk-...

# Optional — Postgres for LiteLLM's admin UI pages (keys, users, spend). See README.
# DATABASE_URL=postgresql://postgres:litellm@localhost:5432/postgres

# Optional: read-aloud in the chat page. With OPENROUTER_API_KEY set it uses
# OpenRouter's speech models (pick model and voice in the page). These override:
# TTS_URL=                 # another OpenAI-style server, e.g. Kokoro: http://localhost:8880/v1
# TTS_MODEL=               # default model (OpenRouter: fish-audio/s2.1-pro-free:free)
# TTS_VOICE=               # default voice
# TTS_API_KEY=             # key for TTS_URL (not needed for OpenRouter)
# TTS_VOICES=              # comma-separated voices when the server doesn't list them
# TTS_INSTRUCTIONS=        # tone/pacing for models that take it

# Optional: dictation in the chat page. Chrome and Edge dictate with their own
# speech service; Brave and some Chromium builds have none and need this. With
# OPENROUTER_API_KEY set it uses OpenRouter's speech-to-text models. These override:
# STT_URL=https://api.groq.com/openai/v1   # any OpenAI-style server: Groq, OpenAI, a local Whisper
# STT_MODEL=mistralai/voxtral-mini-transcribe-3-0   # OpenRouter default; elsewhere whisper-1
# STT_LANGUAGE=en          # default language, ISO-639-1 (the page can override it)
# STT_API_KEY=             # key for STT_URL (not needed for OpenRouter or the Gateway)

# Optional: benchmark numbers (quality, coding, speed, prices) for the Routing
# page's model boxes and tiers, from Artificial Analysis's free API
# (https://artificialanalysis.ai/, sign up for a key). Without it you type them in.
# ARTIFICIAL_ANALYSIS_API_KEY=

# --- Launch settings (all optional). Mostly for Docker; see "Choose how it works"
# in the README. Each wins over the dashboard and config files at every start.
# After a change: docker compose up -d --build

# How each request's model is chosen: jev (Jev via OpenRouter, the default),
# laya or routellm (classifier on this machine, 2 GB+ memory), llm (a chat model
# rates the request), passthrough (no routing: every request to PASSTHROUGH_MODEL)
# HARNESS_MODE=jev

# The models the Router picks between (names from config.yaml)
# STRONG_MODEL=or-claude-sonnet-5.5
# WEAK_MODEL=fast-openrouter
# WEAK_MODEL_TOOLS=or-gpt-6-luna      # easy requests that use tools (Claude Code)
# WEAK_MODEL_OVERFLOW=fallback-openrouter
# ROUTER_MODEL=                       # jev: Jev version; llm: the rating model (default openai/gpt-4o-mini)
# ROUTER_BASE_URL=                    # e.g. http://HOST:8001 for a laya-serve (with ROUTER_BACKEND=systemone)
# ROUTER_BACKEND=                     # set the classifier directly instead of HARNESS_MODE
# ROUTER_API_KEY_ENV=                 # name of the variable holding the classifier's key
# ROUTER_TIMEOUT=                     # seconds

# Passthrough: a name from config.yaml or a provider id (openrouter/..., openai/..., anthropic/...)
# PASSTHROUGH_MODEL=or-claude-sonnet-5.5
# PASSTHROUGH_API_BASE=               # for an OpenAI-style server of your own
# PASSTHROUGH_API_KEY=

# Interceptor: send every request to one model, prompt transforms on/off, models when the Router is down
# PIN_MODEL=
# HARNESS_TRANSFORMS=on
# ROUTER_DOWN_MODEL=fallback-openrouter
# ROUTER_DOWN_TOOLS_MODEL=fallback-openrouter-tools

# Reach the harness from a phone over https with a Cloudflare tunnel (Docker).
# COMPOSE_PROFILES=tunnel needs the token from Cloudflare (README: "Reach it
# from your phone"); tunnel-quick needs nothing and gives a random address.
# Combine with others: COMPOSE_PROFILES=local,tunnel. Needs HARNESS_PASSWORD.
# TUNNEL_TOKEN=

# Local models with Ollama in Docker; each becomes model local-NAME
# COMPOSE_PROFILES=local
# LOCAL_MODELS=qwen2.5-coder:7b
# OLLAMA_URL=http://ollama:11434                 # Docker default; another Ollama elsewhere
# LOCAL_ENGINE_URL=http://host.docker.internal:8000  # Docker default: Tier 1 engine on this machine

# Task runner (npm run all starts it): which folders agents may work on repos in
# (separate several with : or ; on Windows; default the repos folder), and how many runs at once.
# RUNNER_ROOTS=C:\Users\you\code
# RUNNER_MAX_RUNS=2

# Langfuse logging (optional): every call through the Gateway shows up in Langfuse,
# grouped by chat or run. Nothing is sent unless both keys are set.
# Keys: cloud.langfuse.com > your project > Settings > API Keys (README: "Langfuse").
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com    # EU cloud default; https://us.cloud.langfuse.com for US;
#                                             # http://langfuse-web:3000 for COMPOSE_PROFILES=langfuse
# LANGFUSE_URL=http://localhost:3001          # where your browser reaches it (self-hosted only)
# LANGFUSE_LOG_CONTENT=0                      # 1: also log prompts and replies (switch on the Settings page)
# Your own Langfuse in Docker (COMPOSE_PROFILES=langfuse, ~3 GB RAM):
# LANGFUSE_SALT=                              # any long random text
# LANGFUSE_ENCRYPTION_KEY=                    # openssl rand -hex 32
# LANGFUSE_DB_PASSWORD=                       # optional; default "langfuse"
# LANGFUSE_INIT_USER_EMAIL=you@example.com    # first-start login (with LANGFUSE_INIT_USER_PASSWORD)
# LANGFUSE_INIT_USER_PASSWORD=
